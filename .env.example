# Copy to .env and fill in. .env is gitignored and never committed.
#
# Do NOT use a leading digit in a key name. `set -a; . ./.env` fails on it and
# zsh echoes the whole line, secret included, into the error output.

# ── FAQ widget ───────────────────────────────────────────────────────────────
# Optional. Without a key the widget still renders but returns a friendly
# "not configured" message instead of an answer. app/api/chat/route.ts reads
# this name exactly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email notifications (lib/notify.ts): contact form submissions and Groowt Flies plays.
RESEND_API_KEY=
# Optional: a sender on a domain verified in Resend. Defaults to Resend's test sender,
# which can only deliver to the Resend account's own address.
RESEND_FROM=
# Optional: where notifications go. Defaults to anique.cs@gmail.com.
NOTIFY_TO=
