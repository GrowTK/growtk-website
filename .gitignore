# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env* is ignored, but the TEMPLATE must be tracked or a fresh
# clone of the factory has nothing to copy from.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scrape workspace (never pushed)
/.scrape/

# factory run state (build timings for the notification emails)
/.factory/

# staged factory-only files pulled out of the starter kit, not part of the site
/_factory-stripped/

# raw source media, too large for git (some exceed GitHub's 100MB limit).
# compressed derivatives actually used by the site live alongside these.
public/brand/hero-gif.gif
public/brand/voice.gif
public/brand/3.png
